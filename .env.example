# Copy this file to .env and fill in your real key.
# .env is git-ignored — never commit real secrets.

# Required for AI-assisted Short Answer grading (semantic evaluation).
GEMINI_API_KEY=

# Optional — override to change the Gemini model used for grading.
# GEMINI_MODEL=gemini-2.5-flash

# Optional — switch the AI grading provider. Defaults to "gemini".
# AI_GRADING_PROVIDER=gemini

# Optional — sets the teacher password the FIRST time the app ever
# starts (no effect after that; the real credential lives in the
# database from then on and is changed via Settings, not this file).
# If left unset, a random password is generated and printed once to
# the server console on first startup.
# TEACHER_INITIAL_PASSWORD=

# Optional — signs the teacher login session cookie. If left unset, a
# random key is generated at every server startup, which simply means
# any previously logged-in browser gets signed out on restart (safe
# default). Set this to a fixed value if you want login sessions to
# survive a server restart.
# SESSION_SECRET_KEY=
